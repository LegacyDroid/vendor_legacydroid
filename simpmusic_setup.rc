# Install SimpMusic as a user app once PackageManager is up. Mirrors the
# Termux install in vendor/legacydroid (termux_setup.rc); runs in the stock
# shell domain (u:r:shell:s0) instead of magisk so it also works on rootless
# Treble/GSI builds where the magisk domain does not exist.
on property:sys.boot_completed=1
    exec u:r:shell:s0 shell shell -- /system/bin/sh /system/etc/simpmusic/simpmusic_setup.sh install
